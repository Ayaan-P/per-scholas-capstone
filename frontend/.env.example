# In production on Netlify, set NEXT_PUBLIC_API_URL="" (empty) so the frontend
# uses /api/* relative paths, which are proxied to Render via netlify.toml.
# In development, set to http://localhost:8000 or leave unset.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here